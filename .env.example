# ===================== Server =====================
PORT=5000
NODE_ENV=development

# Frontend origin (CORS + email links)
CLIENT_URL=http://localhost:5173

# ===================== Database =====================
# MongoDB connection string (Atlas or local)
DATABASE_URL=mongodb://127.0.0.1:27017/food_app

# ===================== Auth / JWT =====================
BCRYPT_SALT_ROUNDS=10
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===================== Stripe =====================
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
# Used to verify webhook signatures (stripe listen / dashboard)
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_CURRENCY=usd

# ===================== Email (SMTP) =====================
# SMTP server (e.g. smtp.gmail.com)
EMAIL_HOST=smtp.gmail.com
# Port: 465 (SSL) or 587 (STARTTLS)
EMAIL_PORT=587
# SMTP account credentials
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# From address shown to recipients
EMAIL_FROM="Food APP <your_email@gmail.com>"

# ===================== Cloudinary =====================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=food-app/foods

# ===================== Delivery =====================
DELIVERY_CHARGE=5
FREE_DELIVERY_THRESHOLD=500

# ===================== Security (Rate Limiting) =====================
# General API: max requests per window per IP (Stripe webhook is excluded)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_API_MAX=300
# Auth endpoints (login/register/password reset/refresh): attempts per window per IP
RATE_LIMIT_AUTH_MAX=20
