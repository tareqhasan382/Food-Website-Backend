# ===================== Server =====================
PORT=5000
NODE_ENV=development

# Frontend origin (CORS + email links)
CLIENT_URL=http://localhost:5173

# ===================== Database =====================
# MongoDB connection string (Atlas or local)
DATABASE_URL=mongodb://127.0.0.1:27017/food_app

# ===================== Auth / JWT =====================
BCRYPT_SALT_ROUNDS=10
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===================== Stripe =====================
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
# Used to verify webhook signatures (stripe listen / dashboard)
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_CURRENCY=usd

# ===================== Email (Resend) =====================
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxx
# Verified sender domain (or onboarding@resend.dev for testing)
EMAIL_FROM=onboarding@resend.dev
# Destination inbox used by integration/smoke tests
EMAIL_TO=your_email@gmail.com

# ===================== Cloudinary =====================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=food-app/foods

# ===================== Delivery =====================
DELIVERY_CHARGE=5
FREE_DELIVERY_THRESHOLD=500
